# Environment Variables for VaultGuard Platform (Module 1: Foundation)

# Environment & Server
ENVIRONMENT=development
PROJECT_NAME="VaultGuard - Anti-Ransomware Backup System"
DEBUG=true
PORT=8000
HOST=0.0.0.0
API_V1_STR=/api/v1
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173","https://vaultguard-5vs4.onrender.com"]

# Frontend build-time API endpoint
VITE_API_URL=https://REPLACE_WITH_BACKEND_SERVICE.onrender.com

# PostgreSQL Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vaultguard_db
POSTGRES_USER=vaultguard_user
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
DATABASE_URL=postgresql+asyncpg://vaultguard_user:REPLACE_WITH_DATABASE_PASSWORD@postgres:5432/vaultguard_db

# Redis Cache & Broker
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# Celery Task Queue
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# MinIO S3-Compatible Object Storage
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=REPLACE_WITH_MINIO_USERNAME
MINIO_ROOT_PASSWORD=REPLACE_WITH_MINIO_PASSWORD
MINIO_BUCKET_NAME=vaultguard-storage
MINIO_SECURE=false
# Use local disk only for a local/demo environment; Render free storage is ephemeral.
LOCAL_STORAGE_ENABLED=true
LOCAL_STORAGE_PATH=local_storage

# First Super Admin Credentials (Seeding)
FIRST_SUPER_ADMIN_EMAIL=admin@vaultguard.internal
FIRST_SUPER_ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD
FIRST_SUPER_ADMIN_NAME="System Super Administrator"

# Endpoint agent authentication
VAULTGUARD_SERVER_URL=http://localhost:8000/api/v1
VAULTGUARD_AUTH_EMAIL=REPLACE_WITH_REGISTERED_ACCOUNT_EMAIL
VAULTGUARD_AUTH_PASSWORD=REPLACE_WITH_REGISTERED_ACCOUNT_PASSWORD


